{
  "name": "x-sweeper-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:unit": "node --experimental-default-type=module --test tests/*.test.mjs",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "test:e2e": "cypress run --config baseUrl=https://x-sweeper-web.s26.staging.adlt.dev",
    "test:e2e:swp-4:local": "cypress run --spec cypress/e2e/swp-4-durable-acceptance-staging.cy.js --config baseUrl=http://127.0.0.1:3000 --env RUN_SWP_4=true,OUTCOME_ENGINE_URL=http://127.0.0.1:8090,SWEEPER_AGENT_URL=http://127.0.0.1:8020",
    "test:e2e:swp-6:local": "cypress run --spec cypress/e2e/swp-6-complete-sweep-local.cy.js --config baseUrl=http://127.0.0.1:3000 --env RUN_SWP_6=true,OUTCOME_ENGINE_URL=http://127.0.0.1:8090,SWEEPER_AGENT_URL=http://127.0.0.1:8020",
    "test:e2e:swp-4": "cypress run --spec cypress/e2e/swp-4-durable-acceptance-staging.cy.js --config baseUrl=https://x-sweeper-web.s26.staging.adlt.dev --env RUN_SWP_4_STAGING=true",
    "test:e2e:swp-31": "cypress run --spec cypress/e2e/swp-31-x-api-review-staging.cy.js --config baseUrl=https://x-sweeper-web.s26.staging.adlt.dev --env RUN_SWP_31=true",
    "test:e2e:swp-33": "cypress run --spec cypress/e2e/swp-33-50-account-review-staging.cy.js --config baseUrl=https://x-sweeper-web.s26.staging.adlt.dev --env RUN_SWP_33=true,STAGING_RELEASE=$STAGING_RELEASE",
    "test:e2e:swp-34": "cypress run --spec cypress/e2e/swp-34-500-account-review-staging.cy.js --config baseUrl=https://x-sweeper-web.s26.staging.adlt.dev --env RUN_SWP_34=true,STAGING_RELEASE=$STAGING_RELEASE",
    "test:e2e:swp-30": "cypress run --spec cypress/e2e/swp-30-apply-reviewed-unfollow-staging.cy.js --config baseUrl=https://x-sweeper-web.s26.staging.adlt.dev --env RUN_SWP_30=true",
    "test:e2e:swp-38:local": "cypress run --spec cypress/e2e/swp-38-confirmed-x-api-unfollow-local.cy.js --config baseUrl=http://127.0.0.1:3000 --env RUN_SWP_38=true,OUTCOME_ENGINE_URL=http://127.0.0.1:8090,SWEEPER_AGENT_URL=http://127.0.0.1:8020,X_API_ADAPTER_URL=http://127.0.0.1:8030",
    "test:e2e:swp-41": "cypress run --spec cypress/e2e/swp-41-chrome-free-review-staging.cy.js --config baseUrl=https://x-sweeper-web.s26.staging.adlt.dev --env RUN_SWP_41=true,STAGING_RELEASE=$STAGING_RELEASE",
    "test:e2e:swp-40": "cypress run --spec cypress/e2e/swp-40-chrome-free-reviewed-action-staging.cy.js --config baseUrl=https://x-sweeper-web.s26.staging.adlt.dev --env RUN_SWP_40=true,STAGING_RELEASE=$STAGING_RELEASE,EXISTING_SWEEP_ID=$EXISTING_SWEEP_ID,AUTHORIZED_UNFOLLOW_HANDLE=$AUTHORIZED_UNFOLLOW_HANDLE,AUTHORIZED_UNFOLLOW_X_USER_ID=$AUTHORIZED_UNFOLLOW_X_USER_ID",
    "test:e2e:swp-40:restore": "cypress run --spec cypress/e2e/swp-40-chrome-free-reviewed-action-staging.cy.js --config baseUrl=https://x-sweeper-web.s26.staging.adlt.dev --env RUN_SWP_40_RESTORE=true,STAGING_RELEASE=$STAGING_RELEASE,EXISTING_SWEEP_ID=$EXISTING_SWEEP_ID,EXISTING_ACTION_ID=$EXISTING_ACTION_ID,AUTHORIZED_UNFOLLOW_HANDLE=$AUTHORIZED_UNFOLLOW_HANDLE,AUTHORIZED_UNFOLLOW_X_USER_ID=$AUTHORIZED_UNFOLLOW_X_USER_ID",
    "test:e2e:swp-35:fresh-local": "cypress run --spec cypress/e2e/swp-35-fresh-presentation-local.cy.js --config baseUrl=http://127.0.0.1:3000 --env OUTCOME_ENGINE_URL=http://127.0.0.1:8090,SWEEPER_AGENT_URL=http://127.0.0.1:8020",
    "test:e2e:swp-35:history-local": "cypress run --spec cypress/e2e/swp-35-history-local.cy.js --config baseUrl=http://127.0.0.1:3000 --env OUTCOME_ENGINE_URL=http://127.0.0.1:8090",
    "test:e2e:swp-35:restore-local": "cypress run --spec cypress/e2e/swp-35-completed-action-local.cy.js --config baseUrl=http://127.0.0.1:3000 --env OUTCOME_ENGINE_URL=http://127.0.0.1:8090,SWEEPER_AGENT_URL=http://127.0.0.1:8020,X_API_ADAPTER_URL=https://x-api-adapter.s26.staging.adlt.dev",
    "test:e2e:swp-35:review-local": "cypress run --spec cypress/e2e/swp-35-reviewed-auto-unfollow-local.cy.js --config baseUrl=http://127.0.0.1:3000 --env RUN_SWP_35_REVIEW_ONLY=true,SWEEP_COUNT=100,OUTCOME_ENGINE_URL=http://127.0.0.1:8090,SWEEPER_AGENT_URL=http://127.0.0.1:8020,X_API_ADAPTER_URL=https://x-api-adapter.s26.staging.adlt.dev",
    "test:e2e:swp-35:local": "cypress run --spec cypress/e2e/swp-35-reviewed-auto-unfollow-local.cy.js --config baseUrl=http://127.0.0.1:3000 --env RUN_SWP_35=true,OUTCOME_ENGINE_URL=http://127.0.0.1:8090,SWEEPER_AGENT_URL=http://127.0.0.1:8020,X_API_ADAPTER_URL=https://x-api-adapter.s26.staging.adlt.dev"
  },
  "dependencies": {
    "@mantine/core": "^8.3.14",
    "@mantine/hooks": "^8.3.14",
    "@tabler/icons-react": "^3.36.1",
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "cypress": "^14.5.4",
    "eslint": "^9",
    "eslint-config-next": "16.1.6"
  }
}
